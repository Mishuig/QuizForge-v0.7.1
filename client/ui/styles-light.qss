/* QuizForge — світла тема */

QWidget {
    font-family: "Inter", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
    background-color: #F8FAFC;
    color: #0F172A;
}
QMainWindow, QDialog, QMessageBox { background-color: #F8FAFC; }
QLabel, QCheckBox, QRadioButton { background: transparent; }

QLabel#titleLabel   { font-size: 24px; font-weight: 700; color: #0F172A; }
QLabel#subtitleLabel{ font-size: 13px; color: #64748B; }
QLabel#logoLabel    { font-size: 18px; font-weight: 700; color: #0F172A; }

QFrame#card, QWidget#card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
}

QPushButton#primaryButton {
    background-color: @ACCENT@;
    color: white;
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background-color: @ACCENT_HOVER@; }

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 10px 20px;
}
QPushButton#secondaryButton:hover { background-color: #F1F5F9; }

QLineEdit, QTextEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 10px 14px;
    color: #0F172A;
}
QLineEdit:focus { border: 1px solid @ACCENT@; }

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #F1F5F9;
}
QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px 12px;
    font-weight: 600;
}

QPushButton#navTab, QPushButton#sidebarButton {
    color: #475569;
    border-radius: 8px;
    padding: 10px 14px;
}
QPushButton#navTab:checked, QPushButton#sidebarButton:checked {
    background-color: #E0E7FF;
    color: #1E40AF;
}
